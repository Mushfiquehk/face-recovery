# Config for the PYTHON training / dataset pipeline only.
# The iOS app does not and cannot read this file: its OpenRouter key is entered
# in Settings and stored in the iOS Keychain (see docs/adr/0003-no-backend-key-on-device.md).

# OpenRouter (image-capable scoring model)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must match the app so re-scored Signals stay comparable:
SCORING_MODEL=z-ai/glm-5.3-flash
SCORING_PROVIDER=DeepInfra
SCORING_SEED=42

# WHOOP API (OAuth + data access) - research strand, not used by the app
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_REDIRECT_URI=http://localhost:8080/whoop/callback
WHOOP_API_BASE_URL=https://api.prod.whoop.com

# Local paths on the Mac, for exports pulled off the phone
EXPORT_INPUT_DIR=./data/exports
DATASET_OUTPUT_DIR=./data/dataset
REPORT_NOTES_PATH=./notes/report-notes.md
