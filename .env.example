# WHOOP API (OAuth + data access)
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret
WHOOP_REDIRECT_URI=face-recovery://whoop/callback
WHOOP_API_BASE_URL=https://api.prod.whoop.com

# LLM provider (image-compatible model for scoring experiments)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4.1
LLM_BASE_URL=https://api.openai.com/v1

# iOS app/runtime config
APP_ENV=development
IOS_BUNDLE_ID=com.yourname.face-recovery
PHOTO_STORAGE_DIR=./data/photos
DATASET_OUTPUT_DIR=./data/dataset
REPORT_NOTES_PATH=./notes/report-notes.md
